{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug CubeVision",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/CubeVision.exe",
      "args": [],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "environment": [
        {
          "name": "PATH",
          "value": "C:\\Users\\huntl\\msys64\\ucrt64\\bin;${env:PATH}"
        }
      ],
      "externalConsole": false,
      "MIMode": "gdb",
      "miDebuggerPath": "C:/Users/huntl/msys64/ucrt64/bin/gdb.exe",
      "setupCommands": [
        {
          "description": "Enable pretty-printing for gdb",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ],
      "preLaunchTask": "Build CubeVision"
    },
    {
      "name": "Run Deployed CubeVision",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/deploy/CubeVision.exe",
      "args": [],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}/build/deploy",
      "environment": [],
      "externalConsole": false,
      "MIMode": "gdb",
      "miDebuggerPath": "C:/Users/huntl/msys64/ucrt64/bin/gdb.exe"
    }
  ]
