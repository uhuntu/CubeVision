{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "CubeVision (Debug)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build-debug/CubeVision",
      "args": [],
      "cwd": "${workspaceFolder}",
      "stopAtEntry": false,
      "externalConsole": false,
      "MIMode": "gdb",
      "miDebuggerPath": "/usr/bin/gdb",
      "setupCommands": [
        {
          "description": "Enable GDB pretty printing",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ],
      "preLaunchTask": "Build CubeVision (Debug)"
    }
  ]
}
