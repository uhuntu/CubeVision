{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build CubeVision (MSVC)",
      "type": "shell",
      "command": "cmd /c build_msvc.bat",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": ["$msCompile"]
    },
    {
      "label": "Deploy CubeVision (MSVC)",
      "type": "shell",
      "command": "cmd /c deploy_msvc.bat",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "build",
      "problemMatcher": []
    }
  ]
}
