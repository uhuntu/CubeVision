{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build CubeVision",
      "type": "shell",
      "command": "cmake --build build --target CubeVision --parallel 4",
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "PATH": "C:\\Users\\huntl\\msys64\\ucrt64\\bin;C:\\Qt\\Tools\\CMake_64\\bin;C:\\Qt\\Tools\\Ninja;${env:PATH}"
        }
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "Deploy CubeVision",
      "type": "shell",
      "command": "cmake --build build --target deploy --parallel 4",
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "PATH": "C:\\Users\\huntl\\msys64\\ucrt64\\bin;C:\\Qt\\Tools\\CMake_64\\bin;C:\\Qt\\Tools\\Ninja;${env:PATH}"
        }
      },
      "group": "build",
      "problemMatcher": []
    }
  ]
}
